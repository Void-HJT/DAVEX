<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="DveBase.mapper.FolderMapper">
    <select id="selectByParentId" parameterType="long" resultType="DveBase.entity.Folder">
        SELECT * FROM folder WHERE parent_id = #{parentId}
    </select>

    <select id="select" parameterType="Long" resultType="DveBase.entity.Folder">
        SELECT * FROM folder WHERE uid = #{id}
    </select>
</mapper>
